# Copie para .env para rodar localmente (nunca suba o .env para o GitHub)
DATABASE_URL=sqlite:///local.db
ML_CLIENT_ID=
ML_CLIENT_SECRET=
SEARCH_TERMS=fone bluetooth,air fryer,smartwatch
MIN_DISCOUNT_PCT=15
RESULTS_PER_TERM=20
# Confirme no painel de afiliados o formato correto do seu link. {url} vira o link do produto.
AFFILIATE_URL_TEMPLATE={url}?matt_tool=SEU_ID&matt_word=SUA_TAG
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_TOKEN=troque-por-uma-senha-longa
